NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# Microsoft (Azure AD / Entra ID) — optional, set to enable Microsoft login
# Use tenant ID "common" to allow personal + org accounts
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# GitHub — optional, set to enable GitHub login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook — optional, set to enable Facebook login
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your-key
COSMOS_DATABASE=bingo
COSMOS_CONTAINER_PHRASES=phrases
COSMOS_CONTAINER_USERS=users
COSMOS_CONTAINER_CARDS=cards
COSMOS_CONTAINER_PROGRESS=progress
ADMIN_EMAIL_ALLOWLIST=admin@example.com
